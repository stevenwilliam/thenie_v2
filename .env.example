# ─────────────────────────────────────────────────────────────────────────────
# Thenie site-configuration service — configuration surface.
#
# Copy to .env and fill in. .env is git-ignored and must stay that way; this
# file is the documented surface and carries no real secrets.
#
#   cp .env.example .env
#   vi .env
# ─────────────────────────────────────────────────────────────────────────────

# development | production
# production additionally REFUSES TO START without an ADMIN_TOKEN, because a
# public deployment with unauthenticated write endpoints is not a warning, it is
# an outage waiting to happen.
APP_ENV=development

APP_PORT=8082

# Every same-day cut-off (BR-7.4) is evaluated in this zone, never in the
# server's local time. Changing it changes when today's orders close.
APP_TIMEZONE=Asia/Jakarta

# debug | info | warn | error
LOG_LEVEL=info
# true in production, so logs are machine-readable
LOG_JSON=false

# ── Database ────────────────────────────────────────────────────────────────
# Own database and own role, matching the one-database-per-project pattern that
# healthy_catering and ruuma already use on this machine. Create them with:
#
#   sudo -u postgres psql -c "CREATE ROLE thenie LOGIN PASSWORD 'REPLACE_ME'"
#   sudo -u postgres createdb -O thenie thenie
#   sudo -u postgres createdb -O thenie thenie_test
#
DATABASE_URL=postgres://thenie:REPLACE_ME@127.0.0.1:5432/thenie?sslmode=disable

# Used only by `go test ./...`. Migrations are applied to it the same way.
TEST_DATABASE_URL=postgres://thenie:REPLACE_ME@127.0.0.1:5432/thenie_test?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_SLOW_QUERY_MS=500

# ── Admin API ───────────────────────────────────────────────────────────────
# One shared bearer token guards every write endpoint. Minimum 24 characters;
# the service refuses to start with a shorter one. Generate with:
#
#   head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
#
# Rotate by changing this and restarting. There is no user system: this service
# has exactly one class of caller, and inventing accounts for that would be
# scaffolding nobody asked for.
ADMIN_TOKEN=REPLACE_ME_AT_LEAST_24_CHARACTERS

# ── CORS ────────────────────────────────────────────────────────────────────
# Origins allowed to READ the public config document. The published page is
# served from a different origin to this API, so it must be listed here or the
# browser will block the hydration fetch.
#
# An unlisted origin gets no CORS headers at all — the Origin is never
# reflected, because a reflected origin plus a leaked token is a working
# cross-site write.
CORS_ORIGINS=https://thenie.id,https://www.thenie.id

# ── Seeding ─────────────────────────────────────────────────────────────────
# Where `thenied seed` reads the captured page from. The seed is EXTRACTED from
# the mirror rather than hand-written, so the database starts as a faithful copy
# of what the site actually shipped and cannot drift from it.
MIRROR_PATH=site/index.html
